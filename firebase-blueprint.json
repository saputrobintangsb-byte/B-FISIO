{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firestore-blueprint.json",
  "entities": {
    "patients": {
      "title": "Patient",
      "description": "Master data pasien fisioterapi dan rekam medis ICF",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mrn": { "type": "string" },
        "fullName": { "type": "string" },
        "dob": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["L", "P"] },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "diagnosis": { "type": "string" },
        "mainComplaint": { "type": "string" },
        "currentMedicalHistory": { "type": "string" },
        "bodyFunction": { "type": "string" },
        "bodyStructure": { "type": "string" },
        "activityLimitation": { "type": "string" },
        "participationRestriction": { "type": "string" },
        "personalFactor": { "type": "string" },
        "environmentalFactor": { "type": "string" },
        "vitalSigns": { "type": "object" },
        "supportingDocs": { "type": "array" },
        "additionalNotes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "totalVisits": { "type": "number" },
        "lastVisitDate": { "type": "string" },
        "lastLocation": { "type": "string" },
        "lastTherapist": { "type": "string" },
        "totalSpending": { "type": "number" },
        "outstandingBalance": { "type": "number" },
        "lastPaymentStatus": { "type": "string" }
      },
      "required": ["id", "fullName", "mrn"]
    },
    "visits": {
      "title": "TherapyVisit",
      "description": "Catatan kunjungan terapi fisioterapi, SOAP, tindakan, dan rincian pembayaran",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "mrn": { "type": "string" },
        "visitNumber": { "type": "number" },
        "date": { "type": "string" },
        "location": { "type": "string" },
        "therapist": { "type": "string" },
        "interventions": { "type": "array" },
        "soap": { "type": "object" },
        "payment": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "patientId", "date"]
    },
    "settings": {
      "title": "AppSettings",
      "description": "Pengaturan klinik, tarif layanan, data terapis, dan intervensi",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "defaultTherapist": { "type": "string" },
        "therapists": { "type": "array" },
        "availableInterventions": { "type": "array" },
        "defaultPricing": { "type": "object" },
        "theme": { "type": "string" },
        "clinicInfo": { "type": "object" }
      }
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /patients/{patientId} {\n      allow read, write: if true;\n    }\n    match /visits/{visitId} {\n      allow read, write: if true;\n    }\n    match /settings/{settingId} {\n      allow read, write: if true;\n    }\n  }\n}"
}
